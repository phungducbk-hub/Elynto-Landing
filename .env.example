# Copy to .env.local for local overrides. All values are optional.

# Public URL of the landing page (used for canonical links, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://elynto.io

# Where "Start free trial" and "Log in" point. Both default to https://beta.elynto.io
# until the real sign-up / log-in routes are confirmed.
NEXT_PUBLIC_SIGNUP_URL=https://beta.elynto.io
NEXT_PUBLIC_LOGIN_URL=https://beta.elynto.io

# Email shown on the Contact page. Leave unset until an official address is confirmed.
# NEXT_PUBLIC_CONTACT_EMAIL=

# Search indexing. Defaults to true only on Vercel production deployments.
# SITE_INDEXABLE=false

# Visit statistics dashboard at /stats. Leave unset to keep it switched off.
# STATS_PASSWORD=

# Where statistics are stored on Vercel: connect "Upstash for Redis" from the Vercel Marketplace,
# which sets these two automatically. Without them, local runs write to .data/stats instead.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: days to keep events (Redis), time zone for days, local folder.
# STATS_RETENTION_DAYS=400
# STATS_TIMEZONE=Asia/Ho_Chi_Minh
# STATS_DATA_DIR=.data/stats
